# Copy to .env and fill in. Never commit .env.
FRED_API_KEY=
ANTHROPIC_API_KEY=
PMEVAL_RAW_DIR=data/raw
PMEVAL_WAREHOUSE_PATH=data/warehouse.duckdb
PMEVAL_FORECAST_HOURS_BEFORE=24
PMEVAL_LOG_LEVEL=INFO
# Optional: Airflow admin password (defaults to admin, local use only)
AIRFLOW_ADMIN_PASSWORD=
# LLM forecaster (live calls are billed per token on your Anthropic API account)
PMEVAL_LLM_MODEL=claude-opus-5-5
PMEVAL_LLM_SAMPLES=3
PMEVAL_LLM_EFFORT=medium
# Optional: URL that receives a JSON {"text": ...} POST when an Airflow task fails
PMEVAL_ALERT_WEBHOOK_URL=
